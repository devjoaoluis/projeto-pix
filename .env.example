# Copie para .env (cp .env.example .env). O .env não vai para o Git.

# --- Docker Compose ---
POSTGRES_USER=root
POSTGRES_PASSWORD=rootpassword
POSTGRES_DB=banco_pix
POSTGRES_PORT=5433
API_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOG_LEVEL=info

# --- Rodar a API FORA do Docker (npm run start:dev) ---
# DB_URL="postgresql://root:rootpassword@localhost:5433/banco_pix"
# O limite diário de transferências zera à meia-noite do fuso do processo Node
TZ=America/Sao_Paulo
